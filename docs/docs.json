{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Actelos",
  "colors": {
    "primary": "#a995c9",
    "light": "#8a79ab",
    "dark": "#a995c9"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "anchors": [
      {
        "anchor": "Documentation",
        "icon": "book-open",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "server/introduction",
                  "server/faq",
                  "server/comparison"
                ]
              },
              {
                "group": "About MCI",
                "pages": ["server/architecture", "server/transport"]
              },
              {
                "group": "Processes",
                "pages": [
                  "server/process-overview",
                  "server/process-access-and-control"
                ]
              },
              {
                "group": "Modules",
                "pages": [
                  "server/module-overview",
                  "server/module-access-and-control"
                ]
              },
              {
                "group": "Definitions",
                "pages": [
                  "server/definition-overview",
                  "server/definition-lifecycle",
                  "server/definition-access-and-control"
                ]
              }
            ]
          }
        ]
      },
      {
        "anchor": "Blog",
        "icon": "newspaper",
        "href": "https://actelos.github.io/blog/"
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": []
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/modelcontrolinterface"
    }
  },
  "description": "Actelos is an open AI lab focusing of giving models efficient and reliable agency.",
  "seo": {
    "indexing": "all"
  },
  "metadata": {
    "timestamp": true
  },
  "interaction": {
    "drilldown": true
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "openapi": "/openapi.json"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#f8f7fa",
      "dark": "#1a1823"
    }
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "latex": true,
    "eyebrows": "breadcrumbs"
  },
  "icons": {
    "library": "lucide"
  }
}
